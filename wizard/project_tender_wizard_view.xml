<odoo>    
    <record id="import_button_wizard_form" model="ir.ui.view">
        <field name="name">import button form</field>
        <field name="model">import.job.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="project_tender_id" invisible="1"/>

                    <field name="excel_file"/>

                </group>
                <footer>
                    <button string="Import" type="object" name="import_excel" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="import_button_wizard_action" model="ir.actions.act_window">
        <field name="name">Import button</field>
        <field name="res_model">import.job.order.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>    
</odoo>
