    <record id="cost_sheet_view_form" model="ir.ui.view">
        <field name="name">cost.sheet.view.form</field>
        <field name="model">cost.sheet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ref"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="analytic_account_id" readonly="1"/>
                            <field name="job_order_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="expected_start_date" />
                            <field name="expected_end_date"/>
                            <field name="BOQ_expected_duration_per_days"/>
                            <field name="output_product" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="UOM_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="close_date"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <div class="o_row">
                                <label for='additional_expenses_type' class="label-additional-expenses"/>
                                <field name="additional_expenses_type" class="oe_inline"/>
                                <field name="additional_expenses_value" class="oe_inline"/>
                            </div>
                            <field name="risk"/>
                            <field name="margin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material">
                            <field name="material_ids">
                                <list editable="bottom">
                                    <field name="job_type" />
                                    <field name="product_id" />
                                    <field name="description" />
                                    <field name="factor" />
                                    <field name="planned_quantity" />
                                    <field name="wastage" />
                                    <field name="quantity_after_wastage" />
                                    <field name="cost_per_uom" />
                                    <field name="cost_price_sub_total" />
                                </list>
                            </field>
                        </page>
                        <page string="Equipment">
                            <field name="equipment_ids">
                                <list editable="bottom">
                                    <field name="job_type" />
                                    <field name="equipment_id" />
                                    <field name="no_of_required_equipment" />
                                    <field name="total_working_hours" />
                                    <field name="cost_per_hour" />
                                    <field name="sub_total" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cost_sheet_action" model="ir.actions.act_window">
        <field name="name">cost sheet action</field>
        <field name="res_model">cost.sheet</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="domain">[]</field> -->
    </record>

    <menuitem
        id="cost_sheet_menu"
        name="Cost Sheet"
        sequence="3"
        parent="tender_base_menu"
        action="cost_sheet_action"/>

</odoo>
